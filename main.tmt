~ lets write a large program

func complex(int a, int b, int c, int d) yields int {
    int intermediate = a + d * b + c - 1
    harvest intermediate
}

func composition(string message, int x, int y, int z) yields int {
    print(message)
    int result = complex(x, y, z, 10)
    harvest -result
}

sprout {
    ~ time to figure out what that value is going to be
    int ret = composition("hi :3", 1, 2, 3)
    print(ret)

    ~ end program.
    harvest tomato
}