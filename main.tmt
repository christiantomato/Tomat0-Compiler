~ nested ifs test

sprout {
    int x = 2
    int y = 4
    if(x > 0 and y > 0) {
        int sum = x + y
        if(sum > 10) {
            print("sum is greater than 10")
        }
        else {
            print("sum is 10 or less")
        }
    }
    else {
        print("x or y is not positive")
    }
    harvest tomato
}