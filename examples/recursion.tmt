~ recursion example.

~ factorial function
func factorial(int n) yields int {
    ~ base case
    if(n equals 1) {
        harvest n
    }
    ~ NOTE: harvest n * factorial(n-1) will not work in tomat0. Function calls inside an expression can clobber needed values. 
    ~ save to intermediate first!
    int result = factorial(n-1)
    ~ multiply and return after recursive call
    harvest n * result
}

~ fibonacci sequence function
func fibonacci(int n) yields int {
    ~ base cases
    if(n equals 0) {
        harvest 0
    }
    if(n equals 1) {
        harvest 1
    }
    ~ compute recursively: Fn = Fn-1 + Fn-2
    int fn1 = fibonacci(n-1)
    int fn2 = fibonacci(n-2)
    ~ add and return after recursive calls
    harvest fn1 + fn2
}

~ entry point
sprout {
    ~ initalize a number
    int num = 8

    ~ compute factorial of num
    print("computing factorial... ")
    print(factorial(num))
    print("\n")

    ~ compute fibonacci term of num
    print("computing fibonacci... ")
    print(fibonacci(num))
    print("\n")

    ~ runtime end
    harvest tomato
}